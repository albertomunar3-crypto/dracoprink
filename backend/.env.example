PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dracoprink_bd
# Zona horaria usada para calcular "hoy" y "este mes" (Colombia: -05:00)
DB_TIMEZONE=-05:00

# Clave para firmar los tokens de sesión. Generar una propia, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Límite de intentos fallidos de login por IP
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# Orígenes permitidos para CORS, separados por coma (* = cualquiera)
CORS_ORIGIN=*
